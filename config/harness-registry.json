{
  "schemaVersion": 1,
  "portableArtifact": {
    "source": "skills/",
    "specification": "https://agentskills.io/specification",
    "policy": "One portable source is installed into native harness paths; native extensions are not adapters."
  },
  "harnesses": [
    {
      "id": "claude-code",
      "displayName": "Claude Code",
      "support": "verified-native",
      "publicSupport": true,
      "projectPath": ".claude/skills",
      "userPath": "~/.claude/skills",
      "source": "https://code.claude.com/docs/en/skills"
    },
    {
      "id": "codex",
      "displayName": "Codex",
      "support": "standard-compatible",
      "publicSupport": false,
      "projectPath": ".codex/skills",
      "userPath": "~/.codex/skills",
      "source": "https://platform.openai.com/docs/agents/skills"
    },
    {
      "id": "cursor",
      "displayName": "Cursor",
      "support": "standard-compatible",
      "publicSupport": false,
      "projectPath": ".cursor/skills",
      "userPath": "~/.cursor/skills",
      "source": "https://prod.cursor.com/docs/skills"
    },
    {
      "id": "devin",
      "displayName": "Devin",
      "support": "standard-compatible",
      "publicSupport": false,
      "projectPath": ".agents/skills",
      "userPath": null,
      "source": "https://docs.devin.ai/product-guides/skills"
    },
    {
      "id": "gemini-cli",
      "displayName": "Gemini CLI",
      "support": "standard-compatible",
      "publicSupport": false,
      "projectPath": ".gemini/skills",
      "userPath": "~/.gemini/skills",
      "source": "https://geminicli.com/docs/cli/skills/"
    },
    {
      "id": "goose",
      "displayName": "Goose",
      "support": "standard-compatible",
      "publicSupport": false,
      "projectPath": ".agents/skills",
      "userPath": "~/.agents/skills",
      "source": "https://goose-docs.ai/docs/guides/context-engineering/using-skills/"
    },
    {
      "id": "kilo",
      "displayName": "Kilo",
      "support": "standard-compatible",
      "publicSupport": false,
      "projectPath": ".kilo/skills",
      "userPath": "~/.kilo/skills",
      "source": "https://github.com/Kilo-Org/kilocode/blob/main/packages/kilo-docs/pages/customize/skills.md"
    },
    {
      "id": "opencode",
      "displayName": "OpenCode",
      "support": "standard-compatible",
      "publicSupport": false,
      "projectPath": ".opencode/skills",
      "userPath": "~/.config/opencode/skills",
      "source": "https://opencode.ai/docs/skills"
    },
    {
      "id": "omarchy",
      "displayName": "Omarchy",
      "support": "native-extension",
      "publicSupport": false,
      "projectPath": null,
      "userPath": "~/.config/omarchy/plugins",
      "source": "https://omarchy.org/manual/shell-plugins/"
    }
  ]
}
