{
  "name": "marketplace",
  "type": "module",
  "version": "4.19.0",
  "scripts": {
    "predev": "node scripts/extract-readme-sections.mjs && node scripts/copy-public-data.mjs",
    "dev": "astro dev",
    "build": "node scripts/build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "skills:generate": "node scripts/discover-skills.mjs",
    "search:generate": "node scripts/generate-unified-search.mjs",
    "validate:routes": "node scripts/validate-routes.mjs",
    "validate:playbooks": "node scripts/validate-playbook-routes.mjs",
    "validate:internal-links": "node scripts/validate-internal-links.mjs",
    "validate": "node scripts/validate-playbook-routes.mjs && node scripts/validate-routes.mjs",
    "validate:dist": "node scripts/validate-playbook-routes.mjs --dist && node scripts/validate-internal-links.mjs",
    "test:a11y": "npx playwright test tests/a11y/",
    "test:production": "npx playwright test --config=playwright.production.config.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "fuse.js": "^7.5.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "archiver": "^8.0.0",
    "axe-core": "^4.13.0"
  }
}
