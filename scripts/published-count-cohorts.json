{
  "schemaVersion": 1,
  "cohorts": {
    "marketplace-visible": {
      "label": "marketplace-visible",
      "description": "Tracked plugin skills reachable from canonical marketplace catalog source roots; hidden adapter trees, the root curriculum, and the curated mirror are excluded.",
      "command": "node scripts/corpus-resolver.mjs --cohort marketplace-visible --json",
      "resolver": "scripts/corpus-resolver.mjs"
    },
    "graded": {
      "label": "graded",
      "description": "Tracked plugin, curriculum, and legacy skills eligible for the grading harness after governed exclusions.",
      "command": "node scripts/corpus-resolver.mjs --cohort graded --json",
      "resolver": "scripts/corpus-resolver.mjs"
    },
    "first-party": {
      "label": "first-party",
      "description": "Tracked plugin skills whose filesystem ancestry has no applicable upstream source record.",
      "command": "node scripts/corpus-resolver.mjs --cohort first-party --json",
      "resolver": "scripts/corpus-resolver.mjs"
    },
    "curated-mirror": {
      "label": "curated-mirror",
      "description": "Tracked skills in skills/.curated whose membership exactly matches the governed curated manifest.",
      "command": "node scripts/corpus-resolver.mjs --cohort curated-mirror --json",
      "resolver": "scripts/corpus-resolver.mjs"
    },
    "curriculum": {
      "label": "curriculum",
      "description": "Tracked skills in the numbered root curriculum, excluding experimental material.",
      "command": "node scripts/corpus-resolver.mjs --cohort curriculum --json",
      "resolver": "scripts/corpus-resolver.mjs"
    }
  },
  "discovery": {
    "roots": ["marketplace/src/pages", "marketplace/src/components"],
    "extension": ".astro",
    "noun": "skills",
    "dynamicExpressionPolicy": "any-braced-expression",
    "ignoredPhrases": ["Tons of Skills"]
  },
  "surfaces": [
    {
      "path": "marketplace/src/pages/index.astro",
      "classification": "live-global",
      "cohort": "marketplace-visible",
      "expression": "fmt(totalSkills)",
      "label": "marketplace-visible",
      "provenance": "<CountProvenance cohort=\"marketplace-visible\" />",
      "status": "enforced"
    },
    {
      "path": "marketplace/src/pages/explore.astro",
      "classification": "live-global",
      "cohort": "marketplace-visible",
      "expression": "_rawStats.totalSkills",
      "label": "marketplace-visible",
      "provenance": "<CountProvenance cohort=\"marketplace-visible\" />",
      "status": "enforced",
      "deferredExpressions": [
        {
          "expression": "item.skillCount",
          "classification": "entity-local",
          "owner": "E1.6 follow-up",
          "reason": "This client-rendered value counts skills attached to one search result, not the marketplace-visible corpus.",
          "label": "entity-local skills",
          "provenance": "data-count-provenance=\"entity-local\"",
          "command": "node scripts/check-published-count-cohorts.mjs --json",
          "contract": "data-count-provenance=\"entity-local\">${item.skillCount} entity-local skills",
          "sink": "metaParts.push",
          "function": "renderCard",
          "call": "renderCard"
        }
      ]
    },
    {
      "path": "marketplace/src/pages/compare-marketplaces.astro",
      "classification": "live-global",
      "cohort": "marketplace-visible",
      "expression": "stats.totalSkills.toLocaleString()",
      "label": "marketplace-visible",
      "provenance": "<CountProvenance cohort=\"marketplace-visible\" />",
      "status": "enforced"
    },
    {
      "path": "marketplace/src/pages/sponsor.astro",
      "classification": "live-global",
      "cohort": "marketplace-visible",
      "expression": "totalSkills.toLocaleString('en-US')",
      "label": "Marketplace-visible",
      "provenance": "<CountProvenance cohort=\"marketplace-visible\" />",
      "status": "enforced"
    },
    {
      "path": "marketplace/src/pages/skills/index.astro",
      "classification": "live-global",
      "cohort": "marketplace-visible",
      "expression": "_rawCatalog.count",
      "label": "marketplace-visible",
      "provenance": "<CountProvenance cohort=\"marketplace-visible\" />",
      "status": "enforced",
      "deferredExpressions": [
        {
          "expression": "${shown}",
          "classification": "query-result-local",
          "owner": "E1.6 follow-up",
          "reason": "This client-rendered value is the current filtered result count, not a stable corpus cohort.",
          "label": "query-result-local skills",
          "provenance": "query-result-local",
          "command": "node scripts/check-published-count-cohorts.mjs --json",
          "contract": "<span data-count-provenance=\"query-result-local\">Showing ${shown} of ${total} query-result-local skills</span>",
          "sink": "el.innerHTML",
          "function": "updateResultsCount",
          "call": "updateResultsCount"
        },
        {
          "expression": "${total}",
          "classification": "query-result-local",
          "owner": "E1.6 follow-up",
          "reason": "This client-rendered value is the current query total paired with the filtered result count, not an independently governed corpus cohort.",
          "label": "query-result-local skills",
          "provenance": "query-result-local",
          "command": "node scripts/check-published-count-cohorts.mjs --json",
          "contract": "<span data-count-provenance=\"query-result-local\">Showing ${shown} of ${total} query-result-local skills</span>",
          "sink": "el.innerHTML",
          "function": "updateResultsCount",
          "call": "updateResultsCount"
        }
      ]
    },
    {
      "path": "scripts/generate-og-image.mjs",
      "classification": "social-image",
      "cohort": "marketplace-visible",
      "expression": "stats.totalSkills",
      "label": "marketplace-visible skills",
      "provenance": "<CountProvenance cohort=\"marketplace-visible\" />",
      "command": "node scripts/corpus-resolver.mjs --cohort marketplace-visible --json",
      "status": "enforced",
      "owner": "E1.6 follow-up",
      "reason": "The generated image carries the cohort, source, and reproduction command in its visible card and metadata sidecar."
    }
  ],
  "deferredGroups": [
    {
      "classification": "packaged-or-bundle-local",
      "owner": "E1.6 follow-up",
      "reason": "Cowork totals count downloadable package contents or one bundle/plugin, not the marketplace-visible cohort; they are reproduced by the generated Cowork manifest after `node scripts/build-cowork-zips.mjs`. The manifest is now required and consumer fallbacks are forbidden; local package/bundle cohort enforcement remains a separate contract.",
      "paths": ["marketplace/src/components/CoworkGrid.astro", "marketplace/src/pages/cowork.astro"]
    },
    {
      "classification": "entity-local",
      "owner": "E1.6 follow-up",
      "reason": "These values count skills attached to one card, spotlight, plugin, or result item; a local-entity labeling contract is still required before E1.6 closes.",
      "paths": [],
      "claims": [
        {
          "path": "marketplace/src/components/KillerSkills.astro",
          "expression": "skillCount.toLocaleString()",
          "classification": "entity-local",
          "owner": "E1.6 follow-up",
          "reason": "The spotlight card reports the skill count attached to one highlighted entity.",
          "label": "entity-local skills",
          "provenance": "data-count-provenance=\"entity-local\"",
          "command": "node scripts/check-published-count-cohorts.mjs --json",
          "contract": "data-count-provenance=\"entity-local\">{skillCount.toLocaleString()} entity-local skills",
          "sink": "rendered",
          "function": "Astro",
          "call": "Astro"
        },
        {
          "path": "marketplace/src/components/PluginCard.astro",
          "expression": "skillCount.toLocaleString()",
          "classification": "entity-local",
          "owner": "E1.6 follow-up",
          "reason": "The reusable card reports the skill count attached to one plugin or skill entity when supplied.",
          "label": "entity-local skills",
          "provenance": "data-count-provenance=\"entity-local\"",
          "command": "node scripts/check-published-count-cohorts.mjs --json",
          "contract": "data-count-provenance=\"entity-local\">{skillCount.toLocaleString()} entity-local skills",
          "sink": "rendered",
          "function": "Astro",
          "call": "Astro"
        },
        {
          "path": "marketplace/src/pages/community.astro",
          "expression": "itemSkillCount.toLocaleString()",
          "classification": "entity-local",
          "owner": "E1.6 follow-up",
          "reason": "The hall-of-fame card reports the skill count attached to one spotlight entity.",
          "label": "entity-local skills",
          "provenance": "data-count-provenance=\"entity-local\"",
          "command": "node scripts/check-published-count-cohorts.mjs --json",
          "contract": "<span class=\"hof-skills\" data-count-provenance=\"entity-local\">{itemSkillCount.toLocaleString()} entity-local skills",
          "sink": "rendered",
          "function": "Astro",
          "call": "Astro"
        },
        {
          "path": "marketplace/src/pages/community.astro",
          "expression": "contributorPluginCount.toLocaleString()",
          "classification": "contributor-local",
          "owner": "E1.6 follow-up",
          "reason": "The contributor card reports plugins attributed to one contributor, not a corpus-wide skill cohort.",
          "label": "contributor-local plugin",
          "provenance": "data-count-provenance=\"contributor-local\"",
          "command": "node scripts/check-published-count-cohorts.mjs --json",
          "contract": "data-count-provenance=\"contributor-local\">{contributorPluginCount.toLocaleString()} contributor-local plugin",
          "sink": "rendered",
          "function": "Astro",
          "call": "Astro"
        },
        {
          "path": "marketplace/src/pages/plugins/[name].astro",
          "expression": "pluginSkillCount.toLocaleString()",
          "classification": "plugin-local",
          "owner": "E1.6 follow-up",
          "reason": "The plugin detail page reports skills belonging to one plugin, not the marketplace corpus.",
          "label": "plugin-local skills",
          "provenance": "data-count-provenance=\"plugin-local\"",
          "command": "node scripts/check-published-count-cohorts.mjs --json",
          "contract": "Skills ({pluginSkillCount.toLocaleString()}) <small data-count-provenance=\"plugin-local\">plugin-local skills",
          "sink": "rendered",
          "function": "Astro",
          "call": "Astro"
        },
        {
          "path": "marketplace/src/pages/plugins/[name].astro",
          "expression": "componentSkillCount.toLocaleString()",
          "classification": "plugin-local",
          "owner": "E1.6 follow-up",
          "reason": "The plugin catalog metadata reports skills attached to one plugin when the detail page has no global skills list for that plugin.",
          "label": "plugin-local skills",
          "provenance": "data-count-provenance=\"plugin-local\"",
          "command": "node scripts/check-published-count-cohorts.mjs --json",
          "contract": "<span class=\"stat-value\" data-count-provenance=\"plugin-local\">{componentSkillCount.toLocaleString()}</span>\n              <span class=\"stat-label\">plugin-local skills",
          "sink": "rendered",
          "function": "Astro",
          "call": "Astro"
        }
      ]
    },
    {
      "classification": "vendor-pack-local",
      "owner": "E1.6 follow-up",
      "reason": "Each generated learning page counts one vendor pack or one category inside that pack, not a repository-wide corpus; the pack-local cohort contract remains separate.",
      "paths": [
        "marketplace/src/pages/learn/apollo/index.astro",
        "marketplace/src/pages/learn/clay/index.astro",
        "marketplace/src/pages/learn/clerk/index.astro",
        "marketplace/src/pages/learn/coderabbit/index.astro",
        "marketplace/src/pages/learn/cursor/index.astro",
        "marketplace/src/pages/learn/customerio/index.astro",
        "marketplace/src/pages/learn/deepgram/index.astro",
        "marketplace/src/pages/learn/exa/index.astro",
        "marketplace/src/pages/learn/firecrawl/index.astro",
        "marketplace/src/pages/learn/fireflies/index.astro",
        "marketplace/src/pages/learn/gamma/index.astro",
        "marketplace/src/pages/learn/granola/index.astro",
        "marketplace/src/pages/learn/groq/index.astro",
        "marketplace/src/pages/learn/ideogram/index.astro",
        "marketplace/src/pages/learn/instantly/index.astro",
        "marketplace/src/pages/learn/juicebox/index.astro",
        "marketplace/src/pages/learn/klingai/index.astro",
        "marketplace/src/pages/learn/langchain/index.astro",
        "marketplace/src/pages/learn/lindy/index.astro",
        "marketplace/src/pages/learn/linear/index.astro",
        "marketplace/src/pages/learn/openrouter/index.astro",
        "marketplace/src/pages/learn/perplexity/index.astro",
        "marketplace/src/pages/learn/posthog/index.astro",
        "marketplace/src/pages/learn/replit/index.astro",
        "marketplace/src/pages/learn/retellai/index.astro",
        "marketplace/src/pages/learn/sentry/index.astro",
        "marketplace/src/pages/learn/supabase/index.astro",
        "marketplace/src/pages/learn/vastai/index.astro",
        "marketplace/src/pages/learn/vercel/index.astro",
        "marketplace/src/pages/learn/windsurf/index.astro"
      ]
    },
    {
      "classification": "learning-hub-aggregate",
      "owner": "E1.6 follow-up",
      "reason": "The learning-hub landing page aggregates skills across vendor packs; it is neither a repository-wide corpus nor a single vendor-pack count, so it requires its own aggregate cohort contract.",
      "paths": ["marketplace/src/pages/learn/index.astro"]
    },
    {
      "classification": "live-copy-or-quality-rule",
      "owner": "E1.6 follow-up",
      "reason": "These active pages contain a stale global literal or a skill-quality threshold that the conservative discovery pass cannot safely classify as a canonical corpus cohort without a focused copy decision.",
      "paths": ["marketplace/src/pages/docs/index.astro", "marketplace/src/pages/grading.astro"]
    },
    {
      "classification": "research-snapshot",
      "owner": "E1.6 follow-up",
      "reason": "These figures are point-in-time research populations, not live corpus totals; each needs a visible snapshot date and reproduction/evidence locator without changing its historical value.",
      "paths": [
        "marketplace/src/pages/research.astro",
        "marketplace/src/pages/research/agent-skill-command-interaction.astro",
        "marketplace/src/pages/research/allowed-tools-surface-area.astro",
        "marketplace/src/pages/research/cicd-integration-patterns.astro",
        "marketplace/src/pages/research/model-tiering-strategy.astro",
        "marketplace/src/pages/research/plugin-composition-patterns.astro",
        "marketplace/src/pages/research/tool-permission-threat-modeling.astro"
      ]
    }
  ]
}
