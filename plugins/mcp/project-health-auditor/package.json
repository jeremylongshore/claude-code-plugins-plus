{
  "name": "@claude-code-plugins-plus/project-health-auditor",
  "version": "1.0.0",
  "description": "Analyze local repos for code health, complexity, test coverage gaps",
  "type": "module",
  "main": "dist/servers/code-metrics.js",
  "scripts": {
    "dev": "tsx watch servers/code-metrics.ts",
    "build": "tsc",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "code-health",
    "metrics",
    "complexity",
    "coverage"
  ],
  "author": "Intent Solutions IO",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "glob": "^13.0.6",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
