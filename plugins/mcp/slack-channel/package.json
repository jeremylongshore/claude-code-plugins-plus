{
  "name": "claude-channel-slack",
  "private": true,
  "version": "0.12.0",
  "description": "Slack channel for Claude Code — two-way chat via Socket Mode",
  "type": "module",
  "bin": "./server.ts",
  "scripts": {
    "start": "bun install --frozen-lockfile --no-summary && bun server.ts",
    "start:node": "npx tsx server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@slack/socket-mode": "3.0.1",
    "@slack/web-api": "8.1.1",
    "tsx": "^4.23.13",
    "zod": "4.5.4"
  },
  "overrides": {
    "axios": "^1.16.1",
    "fast-uri": "^3.1.2",
    "form-data": "^4.0.6",
    "ws": "^8.21.0",
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@types/bun": "1.4.0",
    "dependency-cruiser": "^18.2.0",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "typescript": "7.0.2"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Jeremy Longshore",
    "email": "jeremy@intentsolutions.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeremylongshore/claude-code-slack-channel.git"
  },
  "lint-staged": {
    "*.{ts,js,json}": "bunx @biomejs/biome check --write --no-errors-on-unmatched"
  }
}
