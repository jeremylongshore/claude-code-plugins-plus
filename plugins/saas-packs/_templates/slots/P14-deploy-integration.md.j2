{% if category in ('ai-ml',) %}
## Serverless API Wrapper (Recommended for AI/ML)

### Why Serverless?
AI/ML integrations are stateless request/response — perfect for serverless. Each function
call receives a prompt, calls the model, and returns the response. No connection pools needed.

### Vercel Edge Function
```typescript
// api/chat.ts — streams AI responses at the edge
import { Client } from '{{ npm_package | default(company + '-sdk') }}';

export const config = { runtime: 'edge' };

export default async function handler(req: Request) {
  const client = new Client({ apiKey: process.env.{{ company | upper }}_API_KEY });
  const { messages } = await req.json();

  const stream = await client.chat.completions.create({
    model: 'default',
    messages,
    stream: true,
  });

  return new Response(stream.toReadableStream(), {
    headers: { 'Content-Type': 'text/event-stream' },
  });
}
```

### Deploy
```bash
vercel secrets add {{ company }}_api_key "${{ company | upper }}_API_KEY"
vercel --prod
```

{% elif category in ('data-platform',) %}
## Data Pipeline Worker (Recommended for Data Platforms)

### Why Persistent Worker?
Data platform integrations need persistent database connections and often run
scheduled jobs — ETL pipelines, materialized view refreshes, data syncs.

### Docker Worker
```dockerfile
FROM node:20-slim
WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production
COPY . .
# Long-running worker with connection pooling
CMD ["node", "worker.js"]
```

### Connection Pooling
```typescript
// worker.ts — maintains connection pool across requests
import { Pool } from '{{ npm_package | default(company + '-sdk') }}';

const pool = new Pool({
  connectionString: process.env.{{ company | upper }}_DATABASE_URL,
  max: {{ pool_max | default('20') }},
  min: {{ pool_min | default('5') }},
  idleTimeoutMillis: 30000,
});

// Graceful shutdown
process.on('SIGTERM', () => pool.end());
```

### Deploy to Cloud Run
```bash
gcloud run deploy {{ company }}-worker \
  --image gcr.io/$PROJECT_ID/{{ company }}-worker \
  --min-instances=1 \
  --set-secrets={{ company | upper }}_DATABASE_URL={{ company }}-db-url:latest
```

{% elif category in ('sales-crm', 'communication', 'fintech') %}
## Webhook Worker (Recommended for {{ category | replace('-', '/') | title }})

### Why Webhooks?
{{ display_name }} sends events ({% if category == 'sales-crm' %}contact created, deal stage changed{% elif category == 'communication' %}message delivered, user replied{% elif category == 'fintech' %}transaction completed, card authorized{% else %}resource updated{% endif %})
to your endpoint. Your worker processes these events and triggers downstream actions.

### Webhook Endpoint
```typescript
// api/webhooks/{{ company }}.ts
export default async function handler(req: Request) {
{% if category == 'fintech' %}
  // CRITICAL: Verify HMAC signature before processing
  const signature = req.headers.get('x-{{ company }}-signature');
  const body = await req.text();
  const expected = crypto.createHmac('sha256', process.env.{{ company | upper }}_WEBHOOK_SECRET!)
    .update(body).digest('hex');
  if (!crypto.timingSafeEqual(Buffer.from(signature!), Buffer.from(expected))) {
    return new Response('Invalid signature', { status: 401 });
  }
  const event = JSON.parse(body);
{% else %}
  const event = await req.json();
{% endif %}

  switch (event.type) {
{% if category == 'sales-crm' %}
    case 'contact.created':
      await enrichAndAssign(event.data.contact);
      break;
    case 'deal.stage_changed':
      await notifySlack(event.data.deal);
      break;
{% elif category == 'communication' %}
    case 'message.delivered':
      await updateDeliveryStats(event.data);
      break;
    case 'message.bounced':
      await handleBounce(event.data.recipient);
      break;
{% elif category == 'fintech' %}
    case 'transaction.completed':
      await syncToAccounting(event.data.transaction);
      break;
    case 'card.declined':
      await alertTeam(event.data);
      break;
{% endif %}
  }

  return new Response('OK', { status: 200 });
}
```

### Deploy
```bash
# Fly.io — always-on, auto-TLS, persistent
fly secrets set {{ company | upper }}_API_KEY="${{ company | upper }}_API_KEY"
fly secrets set {{ company | upper }}_WEBHOOK_SECRET="${{ company | upper }}_WEBHOOK_SECRET"
fly deploy
```

