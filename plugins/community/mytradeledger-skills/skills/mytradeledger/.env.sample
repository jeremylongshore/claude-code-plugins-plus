# MyTradeLedger API configuration for the `mytradeledger` skill.
# Copy this file to `.env` in the same directory and fill in real values:
#   cp .env.sample .env && chmod 600 .env
# `.env` is gitignored and must NEVER be committed. This `.env.sample` is the
# committed template and must contain NO real secrets.
#
# Create a personal access token in MyTradeLedger: Settings -> API Tokens
# (web app route /app/settings/tokens) -> generate a token and copy it ONCE.

# Base URL of your MyTradeLedger instance, with NO trailing /api.
# Hosted service: https://mytradeledger.com  (this is also the default if unset)
# Self-hosted example: https://mytradeledger.home.arpa
MTL_URL=https://mytradeledger.com

# Personal access token (sent as `Authorization: Bearer <token>`)
MTL_TOKEN=your_token_here
